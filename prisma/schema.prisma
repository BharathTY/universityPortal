generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
}

enum MasterUniversityType {
  PRIVATE
  DEEMED
  STATE_GOVT
}

enum ProgramLevel {
  UG
  PG
}

enum HostelGender {
  BOYS
  GIRLS
}

enum HostelRoomType {
  AC
  NON_AC
}

enum HostelSharing {
  SINGLE
  DOUBLE
  TRIPLE
  TWO_SHARING
  FOUR_SHARING
}

enum ScholarshipType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CetAllocationMode {
  SEATS
  PERCENT
}

enum UserAccountStatus {
  ACTIVE
  INACTIVE
}

/// PRD lead lifecycle statuses (§4.4, §9).
enum AdmissionLeadStatus {
  NEW_LEAD
  INTERESTED
  NOT_INTERESTED
  CALL_BACK
  READY_TO_PAY
  PAYMENT_DONE
  IN_FUTURE
  RNR
  SWITCH_OFF
  WRONG_NUMBER
  ENROLLED
  CAMPUS_VISIT_DONE
  SENT_TO_CAMPUS
}

enum LeadPipelineStatus {
  NEW
  LOST
  CONVERTED
}

enum ApplicationPaymentStatus {
  NONE
  REGISTRATION_PENDING
  REGISTRATION_PAID
  PROGRAM_PENDING
  PROGRAM_PAID
}

enum AdmissionReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentCollectedBy {
  STUDENT
  CONSULTANT
  SPOC
}

enum DocumentKind {
  MOU
  EVENT_PHOTO
  STUDENT_PHOTO
}

/// Master list of 1,386+ Indian universities for onboarding search (§8).
model MasterUniversity {
  id             String               @id @default(cuid())
  externalId     String               @unique
  name           String
  shortname      String?
  state          String
  stateCode      String?
  district       String
  address        String?
  city           String?
  pincode        String?
  website        String?
  universityType MasterUniversityType @default(PRIVATE)
  priority       Boolean              @default(false)
  createdAt      DateTime             @default(now())

  @@index([name])
  @@index([state])
  @@index([district])
}

model University {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  email     String?  @unique
  phone     String?
  location  String?
  address   String?
  state     String?
  district  String?
  city      String?
  pincode   String?
  website   String?
  logoUrl   String?
  /// Linked master record when onboarded via search (§4.2 step 1).
  masterUniversityId String?
  /// University type label for consultant directory cards.
  universityType     MasterUniversityType?
  /// SPOC at university side.
  spocName           String?
  spocDesignation    String?
  spocMobile         String?
  spocEmail          String?
  spocs              UniversitySpoc[]
  /// Programs offered flags.
  offersUg           Boolean              @default(false)
  offersPg           Boolean              @default(false)
  ugStreams          String[]             @default([])
  pgStreams          String[]             @default([])
  targetStudents     Int?
  registrationFee    Decimal?             @db.Decimal(12, 2)
  applicationFee     Decimal?             @db.Decimal(12, 2)
  /// University UPI ID for student registration fee (shown on consultant collect-payment QR).
  paymentUpiId       String?
  /// Razorpay Route linked account for automatic university share transfer (optional).
  razorpayLinkedAccountId String?
  messFee            Decimal?             @db.Decimal(12, 2)
  examFee            Decimal?             @db.Decimal(12, 2)
  otherAdminCharges  String?
  otherAdminAmount   Decimal?             @db.Decimal(12, 2)
  mouFileUrl         String?
  eventPhotoUrls     String[]             @default([])
  status    UniversityStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  applications Application[]
  academicYears AcademicYear[]
  streams       Stream[]
  admissionLeads AdmissionLead[]
  consultantAssignments ConsultantUniversity[]
  hostelFees    UniversityHostelFee[]
  cetSeats      UniversityCetSeat[]
  documents     UniversityDocument[]
  scholarships  UniversityScholarship[]
}

model UniversitySpoc {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  designation  String
  mobile       String
  email        String
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([universityId])
}

model UniversityCetSeat {
  id              String             @id @default(cuid())
  universityId    String
  university      University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  programLevel    ProgramLevel
  programName     String?
  streamName      String
  allocationMode  CetAllocationMode  @default(SEATS)
  allocationValue Decimal?           @db.Decimal(8, 2)
  seatCount       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([universityId])
}

model UniversityScholarship {
  id           String           @id @default(cuid())
  universityId String
  university   University       @relation(fields: [universityId], references: [id], onDelete: Cascade)
  type         ScholarshipType
  value        Decimal          @db.Decimal(12, 2)
  criteria     String[]         @default([])
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([universityId])
}

model UniversityDocument {
  id           String       @id @default(cuid())
  universityId String
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  kind         DocumentKind
  fileName     String
  fileUrl      String
  academicYear String?
  uploadedAt   DateTime     @default(now())

  @@index([universityId])
}

model UniversityHostelFee {
  id           String         @id @default(cuid())
  universityId String
  university   University     @relation(fields: [universityId], references: [id], onDelete: Cascade)
  gender       HostelGender
  roomType     HostelRoomType
  sharing      HostelSharing  @default(TWO_SHARING)
  amount       Decimal?       @db.Decimal(12, 2)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([universityId, gender, roomType, sharing])
  @@index([universityId])
}

model ConsultantUniversity {
  userId       String
  universityId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, universityId])
  @@index([universityId])
}

model AcademicYear {
  id           String   @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  label        String
  sortOrder    Int      @default(0)
  leads        AdmissionLead[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([universityId, label])
  @@index([universityId])
}

model Stream {
  id           String   @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  degreeType   String?
  programLevel ProgramLevel?
  durationYears Int?
  intakeMonth  String?
  streamFee    Decimal? @db.Decimal(12, 2)
  tuitionYear1 Decimal? @db.Decimal(12, 2)
  tuitionTotal Decimal? @db.Decimal(12, 2)
  collegeFee   Decimal? @db.Decimal(12, 2)
  applicationFee Decimal? @db.Decimal(12, 2)
  messFee      Decimal? @db.Decimal(12, 2)
  examFee      Decimal? @db.Decimal(12, 2)
  otherAdminCharges String?
  otherAdminAmount Decimal? @db.Decimal(12, 2)
  eligibility  String?
  totalSeats   Int      @default(0)
  filledSeats  Int      @default(0)
  sortOrder    Int      @default(0)
  leads        AdmissionLead[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([universityId, name])
  @@index([universityId])
}

model AdmissionLead {
  id               String              @id @default(cuid())
  universityId     String
  university       University          @relation(fields: [universityId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  streamId         String
  stream           Stream              @relation(fields: [streamId], references: [id], onDelete: Restrict)
  firstName        String
  lastName         String
  email            String
  mobile           String
  consultantCode   String
  consultantRoleId String
  consultantRole   Role                @relation(fields: [consultantRoleId], references: [id], onDelete: Restrict)
  admissionStatus  AdmissionLeadStatus @default(NEW_LEAD)
  pipelineStatus   LeadPipelineStatus  @default(NEW)
  nationality      String?
  specialization   String?
  referralFirstName String?
  referralLastName  String?
  referralPhone     String?
  referralEmail     String?
  admissionState    String?
  branchName        String?
  /// Extended PRD §5.4 fields
  gender            String?
  dateOfBirth       DateTime?
  whatsappNumber    String?
  programInterest   ProgramLevel?
  address           String?
  district          String?
  state             String?
  pincode           String?
  familyIncome      Decimal?            @db.Decimal(14, 2)
  fatherName        String?
  fatherMobile      String?
  motherName        String?
  motherMobile      String?
  photoUrl          String?
  aadhaarAvailable  Boolean?
  panAvailable      Boolean?
  certificationDone Boolean?
  sslcBoard         String?
  sslcSchool        String?
  sslcYear          Int?
  sslcPercent       Decimal?            @db.Decimal(5, 2)
  qualificationType String?
  pucBoard          String?
  pucYear           Int?
  pucPercent        Decimal?            @db.Decimal(5, 2)
  degreeName        String?
  degreeStream      String?
  degreeCollege     String?
  degreeUniversity  String?
  degreePercent     Decimal?            @db.Decimal(5, 2)
  ieltsScore        String?
  toeflScore        String?
  otherExamName     String?
  otherExamScore    String?
  otherExamDetails  String?
  createdByUserId  String?
  createdBy        User?               @relation("LeadCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  batchId          String?
  batch            Batch?              @relation(fields: [batchId], references: [id], onDelete: SetNull)
  assignedPartnerDisplayName String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  application Application?
  statusHistory AdmissionLeadStatusHistory[]
  payments      LeadPayment[]

  @@index([universityId])
  @@index([academicYearId])
  @@index([streamId])
  @@index([consultantCode])
  @@index([consultantRoleId])
  @@index([createdByUserId])
  @@index([batchId])
  @@index([email])
  @@index([mobile])
  @@index([admissionStatus])
  @@index([createdAt])
}

model LeadPayment {
  id              String                   @id @default(cuid())
  leadId          String
  lead            AdmissionLead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  amount          Decimal                  @db.Decimal(12, 2)
  universityShare Decimal?                 @db.Decimal(12, 2)
  platformShare   Decimal?                 @db.Decimal(12, 2)
  status          PaymentTransactionStatus @default(PENDING)
  transactionRef  String                   @unique @default(cuid())
  collectedBy     PaymentCollectedBy
  collectedByUserId String?
  collectedByUser User?                    @relation(fields: [collectedByUserId], references: [id], onDelete: SetNull)
  paymentMethod   String?
  createdAt       DateTime                 @default(now())

  @@index([leadId])
}

model AdmissionLeadStatusHistory {
  id              String              @id @default(cuid())
  leadId          String
  lead            AdmissionLead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus      AdmissionLeadStatus
  toStatus        AdmissionLeadStatus
  changedByUserId String?
  changedBy       User?               @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@index([leadId])
  @@index([changedByUserId])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  phone     String?
  phoneAlternate String?
  passwordHash String?
  accountStatus UserAccountStatus @default(ACTIVE)
  /// Consultant profile (§4.3)
  companyName   String?
  designation   String?
  gstNumber     String?
  panNumber     String?
  address       String?
  city          String?
  district      String?
  state         String?
  academicYear  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  inviteToken      String?   @unique
  inviteSentAt     DateTime?
  inviteAcceptedAt DateTime?

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  studentOfId String?
  studentOf   User?   @relation("StudentToConsultant", fields: [studentOfId], references: [id], onDelete: SetNull)
  students    User[]  @relation("StudentToConsultant")

  reportsToConsultantId String?
  reportsToConsultant   User?   @relation("ConsultantInvites", fields: [reportsToConsultantId], references: [id], onDelete: SetNull)
  invitedTeamMembers    User[]  @relation("ConsultantInvites")

  branchName String?

  /// Student profile (§7.3)
  gender         String?
  dateOfBirth    DateTime?
  whatsappNumber String?
  pincode        String?
  districtStudent String?
  stateStudent   String?
  ieltsScore     String?
  toeflScore     String?
  passportNumber String?
  passportExpiry DateTime?
  sslcSchool     String?
  sslcBoard      String?
  sslcPercent    Decimal?  @db.Decimal(5, 2)
  pucType        String?
  pucInstitution String?
  pucYear        Int?
  pucPercent     Decimal?  @db.Decimal(5, 2)
  degreeName     String?
  degreeStream   String?
  degreeCollege  String?
  degreeUniversity String?
  degreePercent  Decimal?  @db.Decimal(5, 2)

  roles         UserRole[]
  batches       Batch[]
  applications  Application[]
  leadsCreated  AdmissionLead[] @relation("LeadCreator")
  consultantUniversities ConsultantUniversity[]
  admissionLeadStatusHistory AdmissionLeadStatusHistory[]
  consultantDocuments ConsultantDocument[]
  leadPaymentsCollected LeadPayment[]
  passwordResets PasswordResetToken[]

  @@index([universityId])
  @@index([studentOfId])
  @@index([reportsToConsultantId])
}

model ConsultantDocument {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         DocumentKind
  fileName     String
  fileUrl      String
  academicYear String
  uploadedAt   DateTime     @default(now())

  @@index([userId])
  @@index([academicYear])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Batch {
  id               String   @id @default(cuid())
  title            String
  code             String
  batchStartDate   DateTime
  admissionEndDate DateTime
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leadPunchToken   String?  @unique
  applications     Application[]
  admissionLeads   AdmissionLead[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId])
}

enum ApplicationStatus {
  APPLICATION_DETAILS_PENDING
  REGISTRATION_FEE_PENDING
  PROGRAM_FEE_PENDING
  APPLICANT_KYC_PENDING
  PERSONAL_DETAILS_PENDING
  EDUCATION_DETAILS_PENDING
  DOCUMENTS_PENDING
  UNDER_L1_VERIFICATION
  UNDER_L2_VERIFICATION
  REJECTED
  COMPLETED
}

enum ApplicationAdmissionPath {
  NATIONAL_EXAM
  DIRECT_ADMISSION
}

model Application {
  id        String   @id @default(cuid())
  referenceCode String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  leadId String? @unique
  lead   AdmissionLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  status ApplicationStatus @default(APPLICATION_DETAILS_PENDING)
  paymentStatus   ApplicationPaymentStatus @default(NONE)
  admissionReview AdmissionReviewStatus @default(PENDING)
  admissionPath ApplicationAdmissionPath?

  admissionVisitDateText  String?
  admissionVisitTimeSlot  String?
  admissionVisitAddress   String?
  admissionVisitAt DateTime?
  campusTourAt     DateTime?
  boardingAddress    String?
  visitVisitorCount  Int?
  lastRazorpayOrderId String?

  @@index([userId])
  @@index([universityId])
  @@index([batchId])
  @@index([status])
  @@index([admissionReview])
}

model Role {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  users          UserRole[]
  admissionLeads AdmissionLead[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
